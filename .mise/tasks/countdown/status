#!/usr/bin/env bash
#MISE description="Show countdown status"
#USAGE flag "--id <id>" default="" help="Only show one countdown id"
#USAGE flag "--label <label>" default="" help="Filter by exact label when listing"
#USAGE flag "--tag <tag>" var=#true default="" help="Filter by tag; repeatable"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run countdown:status" header="Show all countdowns"
#USAGE example "mise run countdown:status --id tea" header="Show one countdown"
#USAGE example "mise run countdown:status --label 'check min' --json" header="Filter by label"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/time.sh"

countdown_row() {
  local dir id label started_epoch deadline_epoch pid notify now elapsed remaining overdue tags status note
  dir="$1"
  [ -d "$dir" ] || return 0

  if ! id="$(time_read_field "$dir" id)"; then
    id="$(basename "$dir")"
  fi
  if ! label="$(time_read_field "$dir" label)"; then
    label=""
  fi
  if ! deadline_epoch="$(time_read_field "$dir" deadline_epoch)"; then
    printf 'countdown %s: invalid state (missing deadline_epoch)\n' "$id" >&2
    return 1
  fi
  if ! pid="$(time_read_field "$dir" pid)"; then
    pid=""
  fi
  if ! notify="$(time_read_field "$dir" notify)"; then
    notify="false"
  fi
  if ! started_epoch="$(time_read_field "$dir" started_epoch)"; then
    started_epoch="$deadline_epoch"
  fi

  now="$(time_epoch_now)"
  elapsed=$((now - started_epoch))
  remaining=$((deadline_epoch - now))
  tags="$(time_tags_inline "$dir")"
  note=""

  if [ "$remaining" -gt 0 ]; then
    status="running"
    if [ "$notify" = "true" ] && ! time_pid_alive "$pid"; then
      note="notifier stale"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$status" "$(time_format_duration "$remaining")" "$(time_format_duration "$elapsed")" "$label" "$tags" "$note"
  else
    status="fired"
    overdue=$((0 - remaining))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$status" "overdue $(time_format_duration "$overdue")" "$(time_format_duration "$elapsed")" "$label" "$tags" "$note"
  fi
}

id="$(time_normalize_empty "${usage_id:-}")"
label_filter="$(time_normalize_empty "${usage_label:-}")"
json="${usage_json:-false}"
filter_tags=()
while IFS= read -r tag; do
  filter_tags+=("$tag")
done < <(time_usage_words "${usage_tag:-}")

if [ -n "$id" ]; then
  time_require_id "$id"
  dir="$(time_item_dir countdown "$id")"
  if [ ! -d "$dir" ]; then
    printf 'time: no such countdown: %s\n' "$id" >&2
    exit 1
  fi
  if [ "$json" = "true" ]; then
    time_countdown_json "$dir"
  else
    {
      printf 'ID\tSTATUS\tREMAINING\tELAPSED\tLABEL\tTAGS\tNOTE\n'
      countdown_row "$dir"
    } | time_table
  fi
  exit 0
fi

kind_dir="$(time_kind_dir countdown)"
items=()
rows=()
found=false
if [ -d "$kind_dir" ]; then
  for dir in "$kind_dir"/*; do
    [ -d "$dir" ] || continue
    if [ ${#filter_tags[@]} -gt 0 ]; then
      time_item_matches "$dir" "$label_filter" "${filter_tags[@]}" || continue
    else
      time_item_matches "$dir" "$label_filter" || continue
    fi
    found=true
    if [ "$json" = "true" ]; then
      items+=("$(time_countdown_json "$dir")")
    else
      rows+=("$(countdown_row "$dir")")
    fi
  done
fi

if [ "$json" = "true" ]; then
  if [ ${#items[@]} -gt 0 ]; then
    printf '%s\n' "${items[@]}" | jq -s .
  else
    printf '[]\n'
  fi
elif $found; then
  {
    printf 'ID\tSTATUS\tREMAINING\tELAPSED\tLABEL\tTAGS\tNOTE\n'
    printf '%s\n' "${rows[@]}"
  } | time_table
else
  time_dim "No countdowns"
fi
