#!/usr/bin/env -S uv run --script
#MISE description="Start a countdown"
#USAGE arg "duration" help="Duration such as 90s, 1m, 1m30s, 01:30, or '1 minute'"
#USAGE flag "--id <id>" default="" help="Countdown id; generated when omitted"
#USAGE flag "--label <label>" default="" help="Human label for this countdown"
#USAGE flag "--tag <tag>" var=#true default="" help="Generic association tag; repeatable"
#USAGE flag "--replace" default=#false help="Replace an existing countdown with the same id"
#USAGE flag "--notify" default=#false help="Ring/write to the controlling terminal when the countdown fires"
#USAGE flag "--quiet" default=#false help="Suppress notification; kept for compatibility with early prototype calls"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run countdown:start 5m --id tea --label 'check tea'" header="Start a named countdown"
#USAGE example "mise run countdown:start 90s --json" header="Start with a generated id"
# /// script
# requires-python = ">=3.10"
# ///

import os
import sys

sys.path.insert(0, os.environ["MISE_CONFIG_ROOT"] + "/lib")

from whora import (
    CountdownStartArgs,
    TimerStore,
    WhoraError,
    bool_env,
    countdown_start,
    main_error,
    normalize_empty,
    parse_duration,
    usage_words,
)


def main() -> int:
    quiet = bool_env(os.environ.get("usage_quiet"))
    notify = bool_env(os.environ.get("usage_notify")) and not quiet
    args = CountdownStartArgs(
        duration_seconds=parse_duration(normalize_empty(os.environ.get("usage_duration"))),
        id=normalize_empty(os.environ.get("usage_id")),
        label=normalize_empty(os.environ.get("usage_label")),
        tags=usage_words(os.environ.get("usage_tag")),
        replace=bool_env(os.environ.get("usage_replace")),
        notify=notify,
        json_output=bool_env(os.environ.get("usage_json")),
        origin_pwd=os.environ.get("MISE_ORIGINAL_CWD") or os.getcwd(),
    )
    return countdown_start(TimerStore.from_env(os.environ), args)


try:
    raise SystemExit(main())
except WhoraError as exc:
    raise SystemExit(main_error(exc)) from None
