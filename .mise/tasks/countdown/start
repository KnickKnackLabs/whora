#!/usr/bin/env bash
#MISE description="Start a countdown"
#USAGE arg "duration" help="Duration such as 90s, 1m, 1m30s, 01:30, or '1 minute'"
#USAGE flag "--id <id>" default="" help="Countdown id; generated when omitted"
#USAGE flag "--label <label>" default="" help="Human label for this countdown"
#USAGE flag "--tag <tag>" var=#true default="" help="Generic association tag; repeatable"
#USAGE flag "--replace" default=#false help="Replace an existing countdown with the same id"
#USAGE flag "--notify" default=#false help="Ring/write to the controlling terminal when the countdown fires"
#USAGE flag "--quiet" default=#false help="Suppress notification; kept for compatibility with early prototype calls"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run countdown:start 5m --id tea --label 'check tea'" header="Start a named countdown"
#USAGE example "mise run countdown:start 90s --json" header="Start with a generated id"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/time.sh"

duration_raw="$(time_normalize_empty "${usage_duration:-}")"
seconds="$(time_parse_duration "$duration_raw")"
id="$(time_normalize_empty "${usage_id:-}")"
label="$(time_normalize_empty "${usage_label:-}")"
replace="${usage_replace:-false}"
notify="${usage_notify:-false}"
quiet="${usage_quiet:-false}"
json="${usage_json:-false}"
generated_id=false
if [ "$quiet" = "true" ]; then
  notify="false"
fi

if [ -z "$id" ]; then
  id="$(time_new_id countdown)"
  generated_id=true
fi
time_require_id "$id"

dir="$(time_item_dir countdown "$id")"
if [ -d "$dir" ] && [ "$replace" != "true" ]; then
  printf 'time: countdown already exists: %s (use --replace or stop it first)\n' "$id" >&2
  exit 1
fi

if [ -d "$dir" ]; then
  time_stop_countdown_worker "$dir"
  rm -rf "$dir"
fi
mkdir -p "$dir"

now_epoch="$(time_epoch_now)"
deadline_epoch=$((now_epoch + seconds))
time_write_field "$dir" id "$id"
time_write_field "$dir" kind "countdown"
time_write_field "$dir" status "running"
time_write_field "$dir" duration_seconds "$seconds"
time_write_field "$dir" started_epoch "$now_epoch"
time_write_field "$dir" deadline_epoch "$deadline_epoch"
time_write_field "$dir" started_at "$(time_iso_now)"
time_write_field "$dir" label "$label"
time_write_field "$dir" notify "$notify"
time_write_field "$dir" origin_pwd "${MISE_ORIGINAL_CWD:-$PWD}"

tags=()
while IFS= read -r tag; do
  tags+=("$tag")
done < <(time_usage_words "${usage_tag:-}")
if [ ${#tags[@]} -gt 0 ]; then
  time_write_tags "$dir" "${tags[@]}"
else
  time_write_tags "$dir"
fi

if [ "$notify" = "true" ]; then
  notify_tty=""
  if [ -t 2 ]; then
    notify_tty="/dev/tty"
  fi

  (
    sleep_pid=""
    # shellcheck disable=SC2329 # invoked by trap on INT/TERM/HUP
    cleanup_countdown_sleep() {
      if time_pid_alive "$sleep_pid"; then
        if kill "$sleep_pid" >/dev/null 2>&1; then
          :
        fi
      fi
      exit 0
    }
    trap cleanup_countdown_sleep INT TERM HUP

    sleep "$seconds" &
    sleep_pid=$!
    printf '%s\n' "$sleep_pid" > "$dir/sleep_pid"

    if wait "$sleep_pid"; then
      :
    else
      exit 0
    fi

    if [ -d "$dir" ] && [ ! -f "$dir/stopped_epoch" ]; then
      fired_epoch="$(date '+%s')"
      printf '%s\n' "$fired_epoch" > "$dir/fired_epoch.tmp"
      mv "$dir/fired_epoch.tmp" "$dir/fired_epoch"
      printf 'fired\n' > "$dir/status"
      if [ -n "$notify_tty" ] && [ -w "$notify_tty" ]; then
        {
          printf '\a\n⏱ countdown done: %s' "$id"
          if [ -n "$label" ]; then
            printf ' — %s' "$label"
          fi
          printf '\n'
        } > "$notify_tty" 2>/dev/null
      fi
    fi
  ) </dev/null >/dev/null 2>&1 3>&- 4>&- &
  worker_pid=$!
  time_write_field "$dir" pid "$worker_pid"
fi

if [ "$json" = "true" ]; then
  time_countdown_json "$dir" | jq --argjson generated_id "$generated_id" '. + {generated_id:$generated_id}'
  exit 0
fi

time_success "⏱ Countdown started"
printf 'ID: %s\n' "$id"
printf 'Duration: %s\n' "$(time_format_duration "$seconds")"
printf 'Notify: %s\n' "$notify"
if [ "$generated_id" = "true" ]; then
  printf 'Generated: yes\n'
fi
if [ -n "$label" ]; then
  printf 'Label: %s\n' "$label"
fi
if [ ${#tags[@]} -gt 0 ]; then
  printf 'Tags: %s\n' "$(time_tags_inline "$dir")"
fi
printf 'State: %s\n' "$dir"
printf '\n'
time_dim "Next:"
printf '  mise run countdown:status --id %s\n' "$id"
printf '  mise run countdown:stop --id %s\n' "$id"
if [ "$notify" != "true" ]; then
  time_dim "Tip: pass --notify if you want a terminal bell/message when it fires."
fi
