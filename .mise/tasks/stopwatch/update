#!/usr/bin/env bash
#MISE description="Update stopwatch metadata"
#USAGE flag "--id <id>" required=#true help="Stopwatch id"
#USAGE flag "--label <label>" default="" help="Set the human label"
#USAGE flag "--clear-label" default=#false help="Clear the human label"
#USAGE flag "--tag <tag>" var=#true default="" help="Add tag; repeatable"
#USAGE flag "--remove-tag <tag>" var=#true default="" help="Remove tag; repeatable"
#USAGE flag "--clear-tags" default=#false help="Remove all tags before adding new tags"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run stopwatch:update --id review --label 'PR review' --tag repo=notes" header="Update label and tags"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/time.sh"

id="$(time_normalize_empty "${usage_id:-}")"
label="$(time_normalize_empty "${usage_label:-}")"
clear_label="${usage_clear_label:-false}"
clear_tags="${usage_clear_tags:-false}"
json="${usage_json:-false}"
time_require_id "$id"

dir="$(time_item_dir stopwatch "$id")"
if [ ! -d "$dir" ]; then
  printf 'time: no such stopwatch: %s\n' "$id" >&2
  exit 1
fi

add_tags=()
while IFS= read -r tag; do
  add_tags+=("$tag")
done < <(time_usage_words "${usage_tag:-}")
remove_tags=()
while IFS= read -r tag; do
  remove_tags+=("$tag")
done < <(time_usage_words "${usage_remove_tag:-}")

changed=false
if [ "$clear_label" = "true" ]; then
  time_write_field "$dir" label ""
  changed=true
elif [ -n "$label" ]; then
  time_write_field "$dir" label "$label"
  changed=true
fi

if [ "$clear_tags" = "true" ]; then
  rm -f "$dir/tags"
  changed=true
fi
if [ ${#remove_tags[@]} -gt 0 ]; then
  time_remove_tags "$dir" "${remove_tags[@]}"
  changed=true
fi
if [ ${#add_tags[@]} -gt 0 ]; then
  time_add_tags "$dir" "${add_tags[@]}"
  changed=true
fi

if ! $changed; then
  printf 'time: nothing to update for stopwatch %s\n' "$id" >&2
  exit 1
fi

if [ "$json" = "true" ]; then
  time_stopwatch_json "$dir"
  exit 0
fi

time_success "✓ Stopwatch updated"
printf 'ID: %s\n' "$id"
if ! current_label="$(time_read_field "$dir" label)"; then
  current_label=""
fi
current_tags="$(time_tags_inline "$dir")"
if [ -n "$current_label" ]; then
  printf 'Label: %s\n' "$current_label"
else
  printf 'Label: —\n'
fi
if [ -n "$current_tags" ]; then
  printf 'Tags: %s\n' "$current_tags"
else
  printf 'Tags: —\n'
fi
