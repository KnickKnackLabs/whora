#!/usr/bin/env -S uv run --script
#MISE description="Update stopwatch metadata"
#USAGE flag "--id <id>" required=#true help="Stopwatch id"
#USAGE flag "--label <label>" default="" help="Set the human label"
#USAGE flag "--clear-label" default=#false help="Clear the human label"
#USAGE flag "--tag <tag>" var=#true default="" help="Add tag; repeatable"
#USAGE flag "--remove-tag <tag>" var=#true default="" help="Remove tag; repeatable"
#USAGE flag "--clear-tags" default=#false help="Remove all tags before adding new tags"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run stopwatch:update --id review --label 'PR review' --tag repo=notes" header="Update label and tags"
# /// script
# requires-python = ">=3.10"
# ///

import os
import sys

sys.path.insert(0, os.environ["MISE_CONFIG_ROOT"] + "/lib")

from whora import UpdateArgs, TimerStore, WhoraError, bool_env, main_error, normalize_empty, stopwatch_update, usage_words


def main() -> int:
    args = UpdateArgs(
        id=normalize_empty(os.environ.get("usage_id")),
        label=normalize_empty(os.environ.get("usage_label")),
        clear_label=bool_env(os.environ.get("usage_clear_label")),
        add_tags=usage_words(os.environ.get("usage_tag")),
        remove_tags=usage_words(os.environ.get("usage_remove_tag")),
        clear_tags=bool_env(os.environ.get("usage_clear_tags")),
        json_output=bool_env(os.environ.get("usage_json")),
    )
    return stopwatch_update(TimerStore.from_env(os.environ), args)


try:
    raise SystemExit(main())
except WhoraError as exc:
    raise SystemExit(main_error(exc))
