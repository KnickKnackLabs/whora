#!/usr/bin/env -S uv run --script
#MISE description="Start a stopwatch"
#USAGE flag "--id <id>" default="" help="Stopwatch id; generated when omitted"
#USAGE flag "--label <label>" default="" help="Human label for this stopwatch"
#USAGE flag "--tag <tag>" var=#true default="" help="Generic association tag; repeatable"
#USAGE flag "--replace" default=#false help="Replace an existing stopwatch with the same id"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run stopwatch:start --id review --label 'PR review'" header="Start a named stopwatch"
#USAGE example "mise run stopwatch:start --label 'quick probe' --json" header="Start with a generated id"
# /// script
# requires-python = ">=3.10"
# ///

import os
import sys

sys.path.insert(0, os.environ["MISE_CONFIG_ROOT"] + "/lib")

from whora import StartArgs, TimerStore, WhoraError, bool_env, main_error, normalize_empty, stopwatch_start, usage_words


def main() -> int:
    args = StartArgs(
        id=normalize_empty(os.environ.get("usage_id")),
        label=normalize_empty(os.environ.get("usage_label")),
        tags=usage_words(os.environ.get("usage_tag")),
        replace=bool_env(os.environ.get("usage_replace")),
        json_output=bool_env(os.environ.get("usage_json")),
        origin_pwd=os.environ.get("MISE_ORIGINAL_CWD") or os.getcwd(),
    )
    return stopwatch_start(TimerStore.from_env(os.environ), args)


try:
    raise SystemExit(main())
except WhoraError as exc:
    raise SystemExit(main_error(exc)) from None
