#!/usr/bin/env -S uv run --script
#MISE description="Show stopwatch summary"
#USAGE flag "--label <label>" default="" help="Filter by exact label"
#USAGE flag "--tag <tag>" var=#true default="" help="Filter by tag; repeatable"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run stopwatch" header="Read-only stopwatch summary"
# /// script
# requires-python = ">=3.10"
# ///

import os
import sys

sys.path.insert(0, os.environ["MISE_CONFIG_ROOT"] + "/lib")

from whora import StatusArgs, TimerStore, WhoraError, bool_env, main_error, normalize_empty, stopwatch_status, usage_words


def main() -> int:
    args = StatusArgs(
        label_filter=normalize_empty(os.environ.get("usage_label")),
        tags=usage_words(os.environ.get("usage_tag")),
        json_output=bool_env(os.environ.get("usage_json")),
    )
    return stopwatch_status(TimerStore.from_env(os.environ), args)


try:
    raise SystemExit(main())
except WhoraError as exc:
    raise SystemExit(main_error(exc))
