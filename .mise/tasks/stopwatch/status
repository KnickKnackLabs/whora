#!/usr/bin/env -S uv run --script
#MISE description="Show stopwatch status"
#USAGE flag "--id <id>" default="" help="Only show one stopwatch id"
#USAGE flag "--label <label>" default="" help="Filter by exact label when listing"
#USAGE flag "--tag <tag>" var=#true default="" help="Filter by tag; repeatable"
#USAGE flag "--json" default=#false help="Print machine-readable JSON"
#USAGE example "mise run stopwatch:status" header="Show all stopwatches"
#USAGE example "mise run stopwatch:status --id review" header="Show one stopwatch"
#USAGE example "mise run stopwatch:status --label 'min thing' --json" header="Filter by label"
# /// script
# requires-python = ">=3.10"
# ///

import os
import sys

sys.path.insert(0, os.environ["MISE_CONFIG_ROOT"] + "/lib")

from whora import (
    StatusArgs,
    TimerStore,
    WhoraError,
    bool_env,
    main_error,
    normalize_empty,
    stopwatch_status,
    usage_words,
)


def main() -> int:
    args = StatusArgs(
        id=normalize_empty(os.environ.get("usage_id")),
        label_filter=normalize_empty(os.environ.get("usage_label")),
        tags=usage_words(os.environ.get("usage_tag")),
        json_output=bool_env(os.environ.get("usage_json")),
    )
    return stopwatch_status(TimerStore.from_env(os.environ), args)


try:
    raise SystemExit(main())
except WhoraError as exc:
    raise SystemExit(main_error(exc)) from None
