#!/usr/bin/env bash
#MISE description="Run tests and Python lint"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" var=#true default="" help="BATS files, directories, and arguments"
#USAGE example "mise run test" header="Run full validation: BATS, pytest, and ruff"
#USAGE example "mise run test test/skeleton.bats" header="Run one BATS test file"
#USAGE example "mise run test --filter doctor" header="Filter BATS tests by name"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"

run_python=false
if [ "$#" -eq 0 ]; then
  run_python=true
fi

bats --print-output-on-failure "$@"

$run_python || exit 0
mise run python:test
exec mise run python:lint
